NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Preferred server-only key for new Supabase projects. When present, it takes
# precedence over the legacy service-role JWT above.
SUPABASE_SECRET_KEY=
# Optional dedicated encryption key for connected account sessions.
# If omitted, SUPABASE_SERVICE_ROLE_KEY is used server-side.
ACCOUNT_SESSION_SECRET=
CRON_SECRET=
# Dedicated workspace whose OAuth session is allowed to authenticate the
# background historical Charts source. Never select an arbitrary tenant.
SPOTIFY_CHARTS_SOURCE_WORKSPACE_ID=
# Optional second factor for the protected source-test endpoint.
SPOTIFY_CHARTS_ADMIN_USER_ID=
SPOTIFY_CHARTS_BR_CSV_URL_TEMPLATE=
SPOTIFY_CHARTS_GLOBAL_CSV_URL_TEMPLATE=
# City feeds stay fail-closed until their period/parser has been validated.
SPOTIFY_CHARTS_CITY_BACKFILL_VALIDATED=
SPOTIFY_CHARTS_BR_SAO_PAULO_CSV_URL_TEMPLATE=
SPOTIFY_CHARTS_BR_RIO_DE_JANEIRO_CSV_URL_TEMPLATE=
SPOTIFY_CHARTS_BR_PORTO_ALEGRE_CSV_URL_TEMPLATE=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=
# Optional genre enrichment. Last.fm calls stay disabled when the key is empty.
LASTFM_API_KEY=
# MusicBrainz requires a meaningful application User-Agent with contact info.
MUSICBRAINZ_USER_AGENT=SoAsBraba-MusicIntelligence/1.0 (contato@soasbraba.com)
# Vercel deployments authenticate AI Gateway automatically with OIDC.
# Use AI_GATEWAY_API_KEY only for local or non-Vercel environments.
AI_GATEWAY_API_KEY=
PLAYLISTS_AI_MODEL=alibaba/qwen3.5-flash
# The URL is injected automatically into the web service by the private
# Vercel Services binding. Set it manually only outside Vercel.
PLAYLISTS_AI_PYTHON_URL=
PLAYLISTS_AI_PYTHON_TOKEN=
PLAYLISTS_AI_SERVICE_TOKEN=
# Use `supabase` em runtimes stateless. Omita localmente para usar SQLite.
PLAYLISTS_AI_STORE=
PLAYLISTS_AI_PYTHON_TIMEOUT_MS=8000
PLAYLISTS_AI_PYTHON_MAINTENANCE_TIMEOUT_MS=55000
